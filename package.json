{
  "name": "MyNaksh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "uniwind:types": "uniwind generate-artifacts --css ./global.css --dts ./src/uniwind-types.d.ts",
    "pods": "cd ios && pod install",
    "setup": "bun install && bun run pods",
    "ios:sim": "react-native run-ios --simulator \"iPhone 16 Pro\"",
    "ios:fresh": "bun run clean:ios && bun run ios:sim",
    "start:reset": "react-native start --reset-cache",
    "clean:ios": "rm -rf ios/build ios/Pods && bun run pods",
    "clean:android": "cd android && ./gradlew clean",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/flash-list": "^2.3.2",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "heroui-native": "^1.0.10",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
